<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="center" hgap="10" prefWidth="500.0" vgap="10" xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="ru.zelmex.salahovcourseach.controller.ModelLines.AddEditModelLinesDialog">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- Название модели -->
        <Label text="Название модели:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Введите название модели" />

        <!-- Тип -->
        <Label text="Тип:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="typeField" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Спорт, Нейкед, Круизер и т.д." />

        <!-- Характеристики -->
        <Label text="Характеристики:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextArea fx:id="specificationsField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                  prefHeight="80.0" promptText="Объем двигателя, мощность, вес и т.д." wrapText="true" />

        <!-- Цена -->
        <Label text="Цена (₽):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Например: 850000" />

        <!-- Кнопка ОК -->
        <Button fx:id="okButton" contentDisplay="CENTER" mnemonicParsing="false" text="ОК"
                GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <!-- Кнопка Отмена -->
        <Button fx:id="cancelButton" contentDisplay="CENTER" mnemonicParsing="false" text="Отмена"
                GridPane.columnIndex="2" GridPane.rowIndex="5" />

        <!-- Сообщение об ошибке -->
        <Label fx:id="errorLabel" textFill="red" GridPane.columnSpan="2" GridPane.rowIndex="4" />
    </children>

    <columnConstraints>
        <ColumnConstraints percentWidth="30.0" />
        <ColumnConstraints percentWidth="50.0" />
        <ColumnConstraints percentWidth="20.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints minHeight="40.0" />
        <RowConstraints minHeight="40.0" />
        <RowConstraints minHeight="90.0" />
        <RowConstraints minHeight="40.0" />
        <RowConstraints minHeight="30.0" />
        <RowConstraints minHeight="40.0" />
    </rowConstraints>
</GridPane>