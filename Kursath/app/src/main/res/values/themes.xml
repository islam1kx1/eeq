<resources>
    <!-- Base application theme -->
    <style name="Theme.Kursath" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#4CAF50</item>
        <item name="colorPrimaryVariant">#388E3C</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#FFC107</item>
        <item name="colorSecondaryVariant">#FFA000</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- 👇 Стиль для кнопок тулбара -->
        <item name="actionButtonStyle">@style/ToolbarButtonStyle</item>
    </style>

    <!-- Стиль кнопок тулбара -->
    <style name="ToolbarButtonStyle" parent="Widget.AppCompat.ActionButton">
        <item name="android:padding">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>